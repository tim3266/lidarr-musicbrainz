# À copier dans /appdata/mediarr/mediarr.env (ne pas commiter mediarr.env)

# Compte MusicBrainz (éditeur). Obligatoire seulement si MB_SEED_SUBMIT=true
MUSICBRAINZ_USER=
MUSICBRAINZ_PASSWORD=
# Releases que tu as créées sur MB (MBIDs séparés par des virgules) — badge « Toi » dans /app
# MUSICBRAINZ_MY_RELEASE_MBIDS=75fe952c-106b-439b-9bee-b2fe2d97a825

# Contact affiché dans le User-Agent (requis par MusicBrainz si 403)
MUSICBRAINZ_APP_CONTACT=mailto:you@example.com

# Fichier YAML dans l’image ou monté dans /config
# Uniquement si MB_RUN_MODE=once (génération au démarrage du conteneur)
# MB_SEED_CONFIG=/config/mon-album.yaml

# true = POST automatique vers l’éditeur (session) en plus du HTML
MB_SEED_SUBMIT=false

# Port HTTP pour télécharger mb-seed.html depuis le LAN
MB_SEED_SERVE_PORT=8787
MB_SEED_PORT=8787

# Mode server (défaut) ou one-shot au démarrage : once
MB_RUN_MODE=server

# Protège POST /v1/album/seed (optionnel, vide = pas de clé)
LIDARR_MB_API_KEY=

# Comparaison cache Servarr via Lidarr (optionnel)
LIDARR_URL=http://127.0.0.1:8686
# Depuis le conteneur lidarr-musicbrainz sur le réseau compose : http://lidarr:8686
LIDARR_API_KEY=

# Dossiers où POST /reconcile peut lire les fichiers (outputPath Lidarr)
# Monter le même chemin en volume read-only dans le service Docker
MB_ALLOWED_SCAN_PATHS=/downloads,/music,/data

# Cache metadata Servarr (comparaison /status et /suggest)
# SERVARR_METADATA_URL=https://api.lidarr.audio/api/v0.4
